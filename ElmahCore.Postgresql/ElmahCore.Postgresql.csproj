<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>8.0</LangVersion>
    <Version>3.0.0</Version>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <AssemblyName>ElmahCore.Postgresql</AssemblyName>
    <PackageId>Elmah.NetCore.Postgresql</PackageId>
    <Authors>Lawrence Shen</Authors>
    <Product>Elmah.NetCore.Postgresql</Product>
    <NeutralLanguage>en-001</NeutralLanguage>
    <PackageProjectUrl>https://github.com/lawrence8358/Elmah.Core</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lawrence8358/Elmah.Core</RepositoryUrl>
    <PackageTags>elmah asp-net-core aspnetcore error-log postgresql pgsql npgsql</PackageTags>
    <Description>ELMAH for ASP.NET Core - PostgreSQL error log storage</Description>
    <Copyright>Copyright © Lawrence Shen</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Npgsql 8.0.9: last release with netstandard2.0 support -->
  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.9" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.203" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElmahCore\ElmahCore.csproj" />
  </ItemGroup>

</Project>